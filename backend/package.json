{
  "name": "realtime-intelligence-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade Real-Time Intelligence Co-pilot Backend",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/app.js",
    "start:prod": "prisma db push --accept-data-loss --skip-generate && node dist/app.js",
    "setup:db": "node setup-db.js",
    "setup:all": "node setup-db.js && npm run prisma:migrate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "jest",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "ai",
    "rag",
    "realtime",
    "copilot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/community": "^0.0.29",
    "@langchain/openai": "^0.0.19",
    "@prisma/client": "^5.9.1",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "faiss-node": "^0.5.1",
    "form-data": "^4.0.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.1.20",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.28.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.20.0",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.16",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.3",
    "prisma": "^5.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "20.x"
  }
}
