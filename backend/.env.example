# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
# Default in the local schema.prisma is SQLite; uncomment the PostgreSQL line
# (and switch the `provider` in schema.prisma to "postgresql") for production.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/realtime_intelligence?schema=public"

# OpenRouter API (only used for LLM completions, NOT embeddings)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# JWT Secret (REQUIRED — generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_long_random_string

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Whisper Configuration
# WHISPER_PROVIDER:
#   "docker" -> onerahmet/openai-whisper-asr-webservice (default; uses /asr endpoint)
#   "openai" -> OpenAI-compatible API (uses /v1/audio/transcriptions, needs WHISPER_API_KEY)
WHISPER_PROVIDER=docker
WHISPER_MODEL=base
WHISPER_API_URL=http://localhost:9000
# WHISPER_API_KEY=  # only needed for WHISPER_PROVIDER=openai

# Vector Store (embeddings run locally via @xenova/transformers — no API key required)
VECTOR_STORE_PATH=./vectorstore
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Logging
LOG_LEVEL=info
