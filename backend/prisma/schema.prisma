// Prisma Schema for Real-Time Intelligence Co-pilot

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     Session[]
  documents    Document[]
  interactions Interaction[]

  @@map("users")
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  status      String   @default("active") // active, paused, completed
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  metadata    String?  // JSON string

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions Interaction[]
  analytics    Analytics[]

  @@index([userId])
  @@map("sessions")
}

model Document {
  id          String   @id @default(uuid())
  userId      String
  filename    String
  originalName String
  mimeType    String
  size        Int
  path        String
  status      String   @default("processing") // processing, ready, failed
  uploadedAt  DateTime @default(now())
  processedAt DateTime?
  metadata    String?  // JSON string

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@index([userId])
  @@index([status])
  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  content    String
  embedding  String?  // JSON serialized vector
  metadata   String?  // JSON string
  chunkIndex Int
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

model Interaction {
  id          String   @id @default(uuid())
  sessionId   String
  userId      String
  type        String   // text, audio
  inputText   String
  audioPath   String?
  timestamp   DateTime @default(now())
  metadata    String?  // JSON string

  session     Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions AiSuggestion[]
  contexts    RagContext[]

  @@index([sessionId])
  @@index([userId])
  @@index([timestamp])
  @@map("interactions")
}

model AiSuggestion {
  id            String   @id @default(uuid())
  interactionId String
  content       String
  confidence    Float
  model         String
  promptTokens  Int?
  completionTokens Int?
  latencyMs     Int?
  createdAt     DateTime @default(now())
  metadata      String?  // JSON string

  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([interactionId])
  @@map("ai_suggestions")
}

model RagContext {
  id            String   @id @default(uuid())
  interactionId String
  documentId    String?
  chunkContent  String
  relevanceScore Float
  metadata      String?  // JSON string
  createdAt     DateTime @default(now())

  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([interactionId])
  @@map("rag_contexts")
}

model Analytics {
  id                String   @id @default(uuid())
  sessionId         String
  totalInteractions Int      @default(0)
  totalSuggestions  Int      @default(0)
  avgConfidence     Float?
  avgLatencyMs      Int?
  documentsUsed     Int      @default(0)
  timestamp         DateTime @default(now())
  metadata          String?  // JSON string

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([timestamp])
  @@map("analytics")
}
